    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "^16",
    "tailwindcss": "^4",
    "tsx": "^4",
    "typescript": "^5"
  }
